GEMINI_API_KEY=
DATABASE_URL=
GROQ_API_KEY=
MONGODB_URI=
QDRANT_URL=
QDRANT_API_KEY=

# --- Google Calendar (MCP) -------------------------------------------------
# Caminho do JSON de credenciais OAuth ("Desktop app") baixado do Google Cloud.
# Guarde FORA do Git (ex.: pasta secrets/, já ignorada) e use caminho sem aspas.
GOOGLE_OAUTH_CREDENTIALS=
# Opcional: onde o MCP guarda o token de login (padrão: pasta do usuário).
GOOGLE_CALENDAR_MCP_TOKEN_PATH=
#
# Passo a passo (uma vez só):
#  1. console.cloud.google.com -> crie/escolha um projeto -> ative a "Google Calendar API".
#  2. Credenciais -> Criar credenciais -> ID do cliente OAuth -> tipo "App para computador".
#     Baixe o JSON. Na tela de público, adicione seu e-mail como usuário de teste.
#  3. Aponte GOOGLE_OAUTH_CREDENTIALS para esse JSON e faça o login uma vez:
#       PowerShell:  $env:GOOGLE_OAUTH_CREDENTIALS="C:\caminho\gcp-oauth.keys.json"
#                    npx @cocal/google-calendar-mcp auth
#  4. Precisa de Node.js (LTS) instalado: o servidor MCP roda via npx.
